# Normalize text files; keep Unity YAML merge-friendly.
* text=auto

*.cs text diff=csharp
*.md text
*.asmdef text
*.json text
*.unity text merge=unityyamlmerge eol=lf
*.prefab text merge=unityyamlmerge eol=lf
*.asset text merge=unityyamlmerge eol=lf
*.meta text eol=lf

# Binary assets
*.png binary
*.jpg binary
*.psd binary
*.wav binary
*.mp3 binary
*.ogg binary
*.ttf binary
*.otf binary
*.dll binary
*.so binary
*.dylib binary
